{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "title": "NeuroSentry \u2014 AI Runtime Security",
  "uid": "neurosentry-runtime",
  "tags": [
    "neurosentry",
    "security",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Agent Uptime",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "neurosentry_uptime_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Model Access Blocked (total)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(neurosentry_model_access_blocked_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cross-Layer Findings (total)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(neurosentry_correlation_findings_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "AI Gateway Cost (USD)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "expr": "sum(neurosentry_gateway_cost_usd_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Correlation Findings by Severity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (severity) (rate(neurosentry_correlation_findings_total[5m]))",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI Gateway Requests by Action",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (action) (rate(neurosentry_gateway_requests_total[5m]))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Events Processed (rate)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(neurosentry_events_total[5m]))",
          "legendFormat": "events/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Correlation Findings by Detection Rule",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (rule) (increase(neurosentry_correlation_findings_total[15m]))",
          "legendFormat": "{{rule}}",
          "refId": "A"
        }
      ]
    }
  ]
}