[Unit]
Description=NeuroSentry eBPF AI Runtime Security
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/neurosentry --config /etc/neurosentry/config.yaml
Restart=on-failure
RestartSec=3
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
