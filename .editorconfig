# EditorConfig — consistent formatting across editors. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,html,js,css,sh}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
