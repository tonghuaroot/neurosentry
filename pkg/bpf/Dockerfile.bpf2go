# Dockerfile for generating eBPF Go bindings using bpf2go
# This allows regenerating eBPF code from macOS
# Build context should be the root of the neurosentry repo

FROM golang:1.24-bookworm

# Install eBPF development tools
RUN apt-get update && apt-get install -y \
    clang \
    llvm \
    libbpf-dev \
    linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

# Install bpf2go
RUN go install github.com/cilium/ebpf/cmd/bpf2go@latest

WORKDIR /app

# Copy the entire Go module (needed for go generate)
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Generate the Go bindings in the bpf package
WORKDIR /app/pkg/bpf
CMD ["go", "generate", "-v", "."]
